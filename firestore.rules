rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /lekplatser/{lekplatsId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bildUrl'])
         && request.resource.data.bildUrl.startsWith('https://firebasestorage.googleapis.com/v0/b/' + request.auth.token.firebase.project_id))
      );
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /incheckningar/{checkinId} {
      // Likes-listan före och efter skrivningen. Äldre incheckningar kan sakna
      // fältet helt, därför get() med tom lista i stället för direkt access —
      // en saknad nyckel ger annars ett fel och nekar hela skrivningen.
      function likesBefore() { return resource.data.get('likes', []); }
      function likesAfter() { return request.resource.data.get('likes', []); }
      function likesAdded() { return likesAfter().toSet().difference(likesBefore().toSet()); }
      function likesRemoved() { return likesBefore().toSet().difference(likesAfter().toSet()); }

      // Mängdjämförelse i stället för listkonkatenering: regelspråket saknar
      // '+' för listor, och ordningen i arrayen ska inte spela någon roll.
      // Längdkontrollen stoppar dubbletter av det egna uid:t.
      function addsOnlyOwnLike(uid) {
        return likesAdded().hasOnly([uid])
               && likesAdded().size() == 1
               && likesRemoved().size() == 0
               && likesAfter().size() == likesBefore().size() + 1;
      }

      function removesOnlyOwnLike(uid) {
        return likesRemoved().hasOnly([uid])
               && likesRemoved().size() == 1
               && likesAdded().size() == 0
               && likesAfter().size() == likesBefore().size() - 1;
      }

      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      // Tillåt bara att lägga till/ta bort EGET UID i likes-arrayen
      allow update: if request.auth != null && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && (
            addsOnlyOwnLike(request.auth.uid)
            || removesOnlyOwnLike(request.auth.uid)
          )
        )
        || (request.auth.uid == resource.data.userId
              && request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly(['bildUrl']))
        // Ägaren kan redigera sin incheckning (lekplatsId och userId är låsta)
        || (request.auth.uid == resource.data.userId
              && request.resource.data.userId == resource.data.userId
              && request.resource.data.lekplatsId == resource.data.lekplatsId
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['betyg', 'kommentar', 'bildUrl', 'gjordaAktiviteter',
                            'klaradeUtmaningar', 'taggadeVanner', 'tidPaLekplats',
                            'redigerad', 'redigeradAt']))
      );

      // Ägaren kan ta bort sin egen incheckning, admins kan moderera bort
      // vilken som helst. Ägargrenen står först med flit: gästincheckningar
      // görs med anonym auth och saknar users-dokument, och då blir
      // admin-uppslaget ett fel som annars hade nekat raderingen.
      // Följdstädning (statistik, kommentarer, bild) sköts av molnfunktionen
      // onCheckinDeleted — reglerna kan inte kaskadradera.
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.userId
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if request.auth != null
                      && resource.data.userId == request.auth.uid;
      }
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      // Användaren kan bara uppdatera sitt eget dokument med tillåtna fält.
      // Friends-arrayen hanteras via Cloud Functions (friendRequests-flödet).
      allow update: if (
          request.auth != null
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'fornamn', 'efternamn', 'smeknamn', 'smeknamnLower', 'profilbildUrl',
                'friends', 'totalCheckinCount', 'visitedPlaygroundIds',
                'trophyProgress', 'favorites', 'expoPushToken',
                'totalCompletedChallenges'
              ])
        ) || (
          // Tillåt inloggad användare att ta bort sig själv ur någon annans friends-array
          request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends'])
          && resource.data.friends.hasAll([request.auth.uid])
          && !request.resource.data.friends.hasAll([request.auth.uid])
          && request.resource.data.friends.size() == resource.data.friends.size() - 1
        );
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /completedChallenges/{lekplatsId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /klaradeUtmaningar/{lekplatsId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /unlockedTrophies/{trophyId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if false;
      }

      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
        // Admins kan skicka notiser till vilken användare som helst
        allow create: if request.auth != null && (
          request.auth.uid == userId ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        );
      }
    }

    match /sponsors/{sponsorId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;

      match /stats/{date} {
        // Bara admins kan läsa statistik
        allow read: if request.auth != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;

        // Sponsorbadgen visas även för utloggade besökare, så loggningen måste
        // vara öppen för gäster. Formen är däremot låst: exakt en känd räknare
        // får stiga med exakt ett steg per skrivning, och datumfältet måste
        // matcha dokument-id:t. Det speglar precis vad trackSponsorEvent gör.
        // OBS: detta hindrar inte någon från att loopa +1-skrivningar. Det
        // kräver App Check, se __tests__/rules/README.md.
        function statsFields() {
          return ['date', 'badgeImpressions', 'popupOpens', 'hittaHitClicks', 'websiteClicks'];
        }
        function counterFields() {
          return ['badgeImpressions', 'popupOpens', 'hittaHitClicks', 'websiteClicks'];
        }
        function changedFields() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }
        // En befintlig räknare som stiger med exakt ett steg. För oförändrade
        // fält blir jämförelsen x == x + 1, alltså falsk.
        function stepsExactlyOne(field) {
          return request.resource.data.get(field, 0) == resource.data.get(field, 0) + 1;
        }
        // Vid create: fältet saknas (standardvärdet passerar) eller är 1.
        function startsAtOne(field) {
          return request.resource.data.get(field, 1) == 1;
        }

        allow create: if request.resource.data.keys().hasOnly(statsFields())
                      && request.resource.data.keys().hasAll(['date'])
                      && request.resource.data.keys().size() == 2
                      && request.resource.data.date == date
                      && startsAtOne('badgeImpressions')
                      && startsAtOne('popupOpens')
                      && startsAtOne('hittaHitClicks')
                      && startsAtOne('websiteClicks');

        allow update: if request.resource.data.keys().hasOnly(statsFields())
                      && changedFields().hasOnly(counterFields())
                      && changedFields().size() == 1
                      && (
                        stepsExactlyOne('badgeImpressions')
                        || stepsExactlyOne('popupOpens')
                        || stepsExactlyOne('hittaHitClicks')
                        || stepsExactlyOne('websiteClicks')
                      );
      }
    }

    match /trophies/{trophyId} {
      allow read: if true;
      allow write: if false;
    }

    match /konfiguration/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /andringsforslag/{forslagId} {
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /friendRequests/{requestId} {
      allow read: if request.auth != null &&
        (resource.data.fromUserId == request.auth.uid ||
         resource.data.toUserId == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.fromUserId == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.toUserId == request.auth.uid;
      allow delete: if request.auth != null &&
        (resource.data.fromUserId == request.auth.uid ||
         resource.data.toUserId == request.auth.uid);
    }

    match /nyheter/{newsId} {
      allow read: if resource.data.publicerad == true
        || (request.auth != null &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /rapporter/{rapportId} {
      // Inloggade användare kan skapa rapporter om sitt eget UID
      allow create: if request.auth != null
                    && request.resource.data.reportedByUserId == request.auth.uid;
      // Ingen annan klientaccess – bara admins via Cloud Functions eller admin-SDK
      allow read, update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      allow delete: if false;
    }

    // Intern samling för idempotens i Cloud Functions — ingen klientaccess
    match /_processedEvents/{eventId} {
      allow read, write: if false;
    }

    // Rate limiting-samling — hanteras enbart av Cloud Functions
    match /_rateLimits/{limitId} {
      allow read, write: if false;
    }

  }
}
