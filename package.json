{
  "name": "lekplatsenmobil",
  "version": "1.0.1",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:dev": "cross-env APP_ENV=development expo start",
    "start:prod": "cross-env APP_ENV=production expo start",
    "android": "expo run:android",
    "android:dev": "cross-env APP_ENV=development expo run:android",
    "android:prod": "cross-env APP_ENV=production expo run:android",
    "ios": "expo run:ios",
    "ios:dev": "cross-env APP_ENV=development expo run:ios",
    "ios:prod": "cross-env APP_ENV=production expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:rules": "firebase emulators:exec --only firestore --project demo-lekplatsen \"jest -c jest.rules.config.js\"",
    "test:perf": "firebase emulators:exec --config firebase.perf.json --only firestore --project demo-lekplatsen-perf \"jest -c jest.perf.config.js\"",
    "test:components": "jest -c jest.components.config.js",
    "test:all": "npm test && npm run test:components && npm run test:rules && npm run test:perf"
  },
  "jest": {
    "displayName": "utils",
    "testMatch": [
      "**/__tests__/utils/**/*.test.js"
    ],
    "transform": {
      "^.+\\.jsx?$": "babel-jest"
    }
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.0",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.4",
    "@sentry/react-native": "~7.11.0",
    "csv-parser": "^3.2.0",
    "expo": "~55.0.5",
    "expo-constants": "~55.0.2",
    "expo-dev-client": "~55.0.11",
    "expo-file-system": "~55.0.10",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.8",
    "expo-image-manipulator": "~55.0.11",
    "expo-image-picker": "~55.0.11",
    "expo-location": "~55.1.2",
    "expo-notifications": "~55.0.11",
    "expo-status-bar": "~55.0.4",
    "expo-store-review": "~55.0.13",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.7.0",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "react-native-maps": "1.26.20",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/react-native": "^13.3.3",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "jest": "^30.3.0",
    "jest-expo": "^55.0.15"
  },
  "private": true
}
